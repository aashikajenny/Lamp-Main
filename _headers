# Cloudflare Pages response headers (copied into dist/ by build.sh)
/images/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=2592000

# Security, for every page:
# - Strict-Transport-Security: browsers always use https here, never plain http. Not for
#   subdomains (no includeSubDomains): email.aashienterprises.store is GoDaddy's webmail login.
# - X-Frame-Options / frame-ancestors: no other site can show these pages inside its own
#   (a trick for fake "click here" pages).
# - Permissions-Policy: the site never asks for the camera, microphone, location or payments.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
